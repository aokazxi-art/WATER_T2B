rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pond config — app writes pond settings (depth/area/thresholds/etc.)
    // directly from the browser so they sync across devices in real time.
    // NOTE: no Firebase Auth on this project, so this rule is open. See README.
    match /pond_registry/{docId} {
      allow read, write: if true;
    }

    // Live sensor readings — read only
    match /ponds/{pondId} {
      allow read: if true;
      allow write: if false;
    }

    // History — read + write allowed (Import CSV, Cloud Function, browser hook)
    match /history/{pondId}/readings/{readingId} {
      allow read, write: if true;
    }
  }
}
